{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/ui/richbox",
      "destination": "/index.html"
    },
    {
      "source": "/ui/richbox/",
      "destination": "/index.html"
    },
    {
      "source": "/ui/richbox/:path*",
      "destination": "/:path*"
    }
  ]
}
